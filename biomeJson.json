{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": false,
	"linter": {
		"enabled": true,
		"rules": {
			"nursery": {
				"noJsonUnsafeValues": "error",
				"useConsistentObjectKeys": "error",
				"usePackageJsonCpu": "off",
				"usePackageJsonEngines": "warn",
				"usePackageJsonValidCpu": "error",
				"usePackageJsonValidEngines": "error"
			},
			"style": {
				"noTopLevelLiterals": "warn"
			},
			"suspicious": {
				"noBiomeFirstException": "error",
				"noDuplicateDependencies": "error",
				"noDuplicateObjectKeys": "error",
				"noEmptyObjectKeys": "warn",
				"noEmptySource": "error",
				"noQuickfixBiome": "error",
				"useBiomeIgnoreFolder": "error"
			}
		}
	}
}
